# Entorno local
NODE_ENV=development
PORT=3000
AUTH_MODE=local

# XAMPP MySQL: cree primero la base de datos eltiburon en phpMyAdmin.
# Si root no tiene contraseña, use mysql://root:@127.0.0.1:3306/eltiburon
DATABASE_URL=mysql://root:@127.0.0.1:3306/eltiburon

# Sesiones locales: cambia este valor por una cadena larga y privada.
LOCAL_SESSION_SECRET=cambia-esta-clave-local-por-una-cadena-larga

# FormSubmit es opcional. Coloca aquí el correo de El Tiburón que recibirá
# reclamos y mensajes; no uses el correo del sistema anterior.
FORMSUBMIT_EMAIL=BakeryAvenueNew@gmail.com

# Autenticación Manus/OAuth (opcional para páginas públicas y funciones de datos).
# No coloque secretos en Git ni comparta este archivo con valores reales.
# MANUS_PROJECT_ID=
# MANUS_JWT_SECRET=
# MANUS_OAUTH_API_URL=
# MANUS_OAUTH_PORTAL_URL=
# MANUS_API_URL=
# MANUS_API_KEY=
# OWNER_OPEN_ID=

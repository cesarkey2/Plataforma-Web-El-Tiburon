  USERS {
    int id PK
    varchar openId UK
    varchar email
    enum role
    timestamp createdAt
  }
  PRODUCTS {
    int id PK
    varchar name
    text description
    decimal price
    varchar imageUrl
    boolean isAvailable
  }

    int id PK
    varchar code UK
    int userId FK
    enum attentionType
    decimal subtotal
    decimal total
    enum status
    timestamp createdAt
  }
  ORDER_ITEMS {
    int id PK
    int orderId FK
    int productId FK
    varchar productName
    int quantity
    decimal unitPrice
    decimal subtotal
  }
  CLAIMS {
    int id PK
    int userId FK
    varchar fullName
    enum claimType
    text description
    enum status
  }
  CONTACT_MESSAGES {
    int id PK
    varchar email
    text message
    enum status
